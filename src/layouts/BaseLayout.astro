---
// Self-hosted Inter (wght axis only; the browser fetches just the subset it needs).
import "@fontsource-variable/inter/wght.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import { getLangFromUrl, switchLangPath, useTranslations } from "../i18n/utils";
import { profile } from "../data/site";

interface Props {
  /** Page name prepended to the site name. Omit on the home page. */
  title?: string;
  description: string;
  /** Absolute or root-relative image for social cards. */
  image?: string;
  /** Real pixel size of `image`. Must match the file, or clients crop it wrong. */
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title,
  description,
  image = "/og-image.png",
  imageWidth = 1200,
  imageHeight = 630,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
// Derived, not hardcoded: project pages share their .webp cover, not the .png OG.
const socialImageType = image.endsWith(".webp") ? "image/webp" : "image/png";
// Home (no title) -> "Juan Giménez · Software Developer"; other pages -> "Projects · Juan Giménez".
const fullTitle = title
  ? `${title} · ${profile.name}`
  : `${profile.name} · ${t("hero.role")}`;

// hreflang alternates — only on localized routes (skipped on the root 404).
const firstSegment = Astro.url.pathname.split("/")[1];
const hasLocalePrefix = firstSegment === "es" || firstSegment === "en";
const alternates = hasLocalePrefix
  ? [
      { hreflang: "es", href: new URL(switchLangPath(Astro.url, "es"), Astro.site) },
      { hreflang: "en", href: new URL(switchLangPath(Astro.url, "en"), Astro.site) },
      { hreflang: "x-default", href: new URL(switchLangPath(Astro.url, "es"), Astro.site) },
    ]
  : [];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content={profile.name} />

    <!-- hreflang: tell search engines about the ES/EN versions -->
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href.href} />
      ))
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <Analytics />

    <!-- Set theme + js flag before paint (avoids theme flash and reveal flash). -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          root.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-white text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      {lang === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>
    <Header />
    <main id="main" class="flex flex-1 flex-col">
      <slot />
    </main>
    <Footer />

    <!-- Reveal-on-scroll: adds `.is-visible` as elements enter the viewport. -->
    <script>
      const els = document.querySelectorAll(".reveal, .reveal-stagger");
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries, observer) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          // threshold 0, not a fraction: the ratio is measured against the
          // element's own size, so an element taller than ~10x the viewport can
          // never reach 0.1 and would stay hidden forever. The bottom rootMargin
          // is what delays the reveal until an element is properly in view.
          { rootMargin: "0px 0px -10% 0px", threshold: 0 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
