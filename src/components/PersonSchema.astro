---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import profilePhoto from "../assets/profile.webp";
import {
  profile,
  bio,
  education,
  skills,
  spokenLanguages,
} from "../data/site";

/**
 * schema.org Person structured data (JSON-LD). Tells search engines who this
 * site is about — name, role, education, skills and social profiles — so they
 * can show a richer result instead of guessing from the page text.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteUrl = Astro.site?.href ?? "https://jscalon.dev/";

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: new URL(`/${lang}/`, siteUrl).href,
  // The portrait, not the social card: schema.org reads `image` as a photograph
  // of the person, and this one is a square headshot rather than a text banner.
  image: new URL(profilePhoto.src, siteUrl).href,
  jobTitle: t("hero.role"),
  description: bio[lang],
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.location.city,
    addressCountry: profile.location.country,
  },
  // No `worksFor`: it used to be the first experience entry, which kept telling search
  // engines Juan still worked at Febeca after he left. Add it back only from a job that is
  // actually current.
  alumniOf: education.map((item) => ({
    "@type": "CollegeOrUniversity",
    name: item.institution,
  })),
  knowsAbout: skills.flatMap((group) => group.items),
  knowsLanguage: spokenLanguages.map((item) => item.name[lang]),
  sameAs: [profile.social.github, profile.social.linkedin],
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(schema)}
/>
