---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { profile } from "../data/site";
import LangSwitcher from "./LangSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = `/${lang}`;

// Normalized so `/es/projects` and `/es/projects/` compare equal.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

/**
 * `section` marks which page a link belongs to. Home matches exactly — as a
 * prefix it would swallow every other route. Sections match their children too,
 * so a project detail page still marks "Proyectos". The in-page anchors have no
 * section: they are positions on the home page, not destinations of their own.
 */
const links = [
  { href: `${base}/`, label: t("nav.home"), section: base, exact: true },
  {
    href: `${base}/projects`,
    label: t("nav.projects"),
    section: `${base}/projects`,
  },
  { href: `${base}/cv`, label: t("cv.title"), section: `${base}/cv` },
  { href: `${base}/#about`, label: t("nav.about") },
  { href: `${base}/#contact`, label: t("nav.contact") },
];

const isCurrent = (link: (typeof links)[number]) =>
  !!link.section &&
  (path === link.section ||
    (!link.exact && path.startsWith(`${link.section}/`)));

const linkClass =
  "rounded-md font-medium transition hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-800 dark:hover:text-white";
const currentClass = "font-semibold text-brand-600 dark:text-brand-400";
const restingClass = "text-slate-600 dark:text-slate-300";
---

<header
  class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur dark:border-slate-800/70 dark:bg-slate-950/80"
>
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 sm:px-6"
    aria-label={lang === "es" ? "Principal" : "Main"}
  >
    <a
      href={`${base}/`}
      class="text-lg font-bold tracking-tight text-slate-900 dark:text-white"
    >
      {profile.name}
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 sm:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link) ? "page" : undefined}
                class:list={[
                  linkClass,
                  "px-3 py-2 text-sm",
                  isCurrent(link) ? currentClass : restingClass,
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex items-center gap-1 border-slate-200 sm:ml-2 sm:border-l sm:pl-2 dark:border-slate-800">
        <LangSwitcher />
        <ThemeToggle />
      </div>
    </div>
  </nav>

  <!-- Mobile nav. Labels never wrap; on very narrow screens the row scrolls. -->
  <ul
    class="flex items-center justify-center gap-0.5 overflow-x-auto border-t border-slate-200/70 px-2 py-2 sm:hidden dark:border-slate-800/70"
  >
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isCurrent(link) ? "page" : undefined}
            class:list={[
              linkClass,
              "block whitespace-nowrap px-2 py-1.5 text-xs",
              isCurrent(link) ? currentClass : restingClass,
            ]}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>
