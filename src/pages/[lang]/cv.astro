---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PersonSchema from "../../components/PersonSchema.astro";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import {
  profile,
  bio,
  experience,
  education,
  skills,
  spokenLanguages,
} from "../../data/site";
import { getProjectsByLang } from "../../utils/projects";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const projects = await getProjectsByLang(lang);

// Strip the protocol so links read cleanly on paper.
const bare = (url: string) => url.replace(/^https?:\/\//, "");

const sectionTitle =
  "cv-heading text-sm font-bold uppercase tracking-wider text-brand-600 dark:text-brand-400";
---

<BaseLayout title={t("cv.title")} description={t("cv.description")}>
  <PersonSchema />

  <div class="mx-auto w-full max-w-3xl px-4 py-12 sm:px-6">
    <!-- Screen-only toolbar -->
    <div class="no-print mb-8 flex flex-wrap items-center justify-between gap-3">
      <a
        href={`/${lang}/`}
        class="text-sm font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400"
      >
        &larr; {t("cv.backToSite")}
      </a>
      <button
        id="print-cv"
        type="button"
        class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
      >
        {t("cv.print")}
      </button>
    </div>

    <article class="cv-sheet">
      <!-- Header -->
      <header class="border-b border-slate-200 pb-6 dark:border-slate-700">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
          {profile.name}
        </h1>
        <p class="mt-1 text-lg font-medium text-brand-600 dark:text-brand-400">
          {t("hero.role")}
        </p>
        <ul
          class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-600 dark:text-slate-400"
        >
          <li>{profile.location}</li>
          <li>
            <a href={profile.whatsapp} class="hover:text-brand-600">
              {profile.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${profile.email}`} class="hover:text-brand-600">
              {profile.email}
            </a>
          </li>
          <li>
            <a href={profile.social.github} class="hover:text-brand-600">
              {bare(profile.social.github)}
            </a>
          </li>
          <li>
            <a href={profile.social.linkedin} class="hover:text-brand-600">
              {bare(profile.social.linkedin)}
            </a>
          </li>
        </ul>
      </header>

      <!-- Profile -->
      <section class="cv-section">
        <h2 class={sectionTitle}>{t("cv.profile")}</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
          {bio[lang]}
        </p>
      </section>

      <!-- Experience -->
      <section class="cv-section">
        <h2 class={sectionTitle}>{t("about.experience")}</h2>
        <ul class="mt-3 space-y-4">
          {
            experience.map((item) => (
              <li class="cv-item">
                <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                  <h3 class="font-semibold text-slate-900 dark:text-white">
                    {item.role[lang]}
                    <span class="font-normal text-slate-600 dark:text-slate-400">
                      {" · "}
                      {item.company}
                    </span>
                  </h3>
                  <span class="text-xs text-slate-500 dark:text-slate-400">
                    {item.period[lang]}
                  </span>
                </div>
                <p class="mt-1 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                  {item.description[lang]}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Education -->
      <section class="cv-section">
        <h2 class={sectionTitle}>{t("about.education")}</h2>
        <ul class="mt-3 space-y-3">
          {
            education.map((item) => (
              <li class="cv-item flex flex-wrap items-baseline justify-between gap-x-3">
                <h3 class="font-semibold text-slate-900 dark:text-white">
                  {item.title[lang]}
                  <span class="font-normal text-slate-600 dark:text-slate-400">
                    {" · "}
                    {item.institution}
                  </span>
                </h3>
                <span class="text-xs text-slate-500 dark:text-slate-400">
                  {item.period[lang]}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Projects -->
      {
        projects.length > 0 && (
          <section class="cv-section">
            <h2 class={sectionTitle}>{t("cv.projects")}</h2>
            <ul class="mt-3 space-y-4">
              {projects.map((project) => (
                <li class="cv-item">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                    <h3 class="font-semibold text-slate-900 dark:text-white">
                      {project.data.title}
                    </h3>
                    {(project.data.liveUrl || project.data.repoUrl) && (
                      <a
                        href={project.data.liveUrl || project.data.repoUrl}
                        class="text-xs text-brand-600 dark:text-brand-400"
                      >
                        {bare(project.data.liveUrl || project.data.repoUrl || "")}
                      </a>
                    )}
                  </div>
                  <p class="mt-1 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                    {project.data.description}
                  </p>
                  <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                    {project.data.stack.join(" · ")}
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Skills -->
      <section class="cv-section">
        <h2 class={sectionTitle}>{t("about.skills")}</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
          {skills.join(" · ")}
        </p>
      </section>

      <!-- Languages -->
      <section class="cv-section">
        <h2 class={sectionTitle}>{t("cv.languages")}</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
          {
            spokenLanguages
              .map((l) => `${l.name[lang]} — ${l.level[lang]}`)
              .join(" · ")
          }
        </p>
      </section>
    </article>
  </div>
</BaseLayout>

<script>
  document
    .getElementById("print-cv")
    ?.addEventListener("click", () => window.print());
</script>

<style is:global>
  .cv-section {
    margin-top: 1.5rem;
  }

  /* Print styles: clean single-column sheet, no site chrome. */
  @media print {
    /* Hide everything from the site shell. */
    header:not(.cv-sheet header),
    footer,
    .no-print {
      display: none !important;
    }

    /*
     * margin: 0 leaves the browser no room to draw its own header/footer
     * (date, page title, URL, page number), so they disappear. The visual
     * margin is recreated with padding on the sheet itself.
     */
    @page {
      size: A4;
      margin: 0;
    }

    html,
    body {
      background: #fff !important;
      color: #000 !important;
    }

    .cv-sheet {
      padding: 14mm 14mm;
    }

    /* Force light colors regardless of the active theme. */
    .cv-sheet,
    .cv-sheet * {
      color: #111 !important;
      background: transparent !important;
      border-color: #ccc !important;
    }

    .cv-sheet a {
      text-decoration: none !important;
    }

    .cv-heading {
      color: #1f60f1 !important;
      font-size: 10.5pt !important;
    }

    .cv-sheet h1 {
      font-size: 20pt !important;
    }

    .cv-sheet h3 {
      font-size: 10.5pt !important;
    }

    .cv-sheet p,
    .cv-sheet li,
    .cv-sheet span,
    .cv-sheet a {
      font-size: 9.5pt !important;
      line-height: 1.4 !important;
    }

    .cv-section {
      margin-top: 10pt !important;
    }

    /* Never split an entry across pages. */
    .cv-item {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .cv-section {
      break-inside: avoid-page;
    }
  }
</style>
