---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import profilePhoto from "../../assets/profile.webp";
import ProjectCard from "../../components/ProjectCard.astro";
import ContactForm from "../../components/ContactForm.astro";
import PersonSchema from "../../components/PersonSchema.astro";
import { useTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import {
  profile,
  bio,
  experience,
  education,
  skills,
} from "../../data/site";
import { getProjectsByLang, projectUrl } from "../../utils/projects";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const projects = await getProjectsByLang(lang);
const featured = projects.filter((p) => p.data.featured);
const cvHref = `/${lang}/cv`;
---

<BaseLayout description={bio[lang]}>
  <PersonSchema />

  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-4 pb-16 pt-16 sm:px-6 sm:pt-24">
    <div
      class="flex flex-col-reverse items-center gap-8 text-center sm:flex-row sm:items-center sm:justify-between sm:gap-12 sm:text-left"
    >
      <div class="reveal-stagger">
        {
          profile.openToWork && (
            <p class="inline-flex items-center gap-2 rounded-full border border-green-500/30 bg-green-500/10 px-3 py-1 text-xs font-medium text-green-700 dark:text-green-400">
              <span
                aria-hidden="true"
                class="h-1.5 w-1.5 rounded-full bg-green-500 motion-safe:animate-pulse"
              />
              {t("hero.available")}
            </p>
          )
        }
        <p class="mt-4 text-sm font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400">
          {t("hero.role")}
        </p>
        <h1
          class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl dark:text-white"
        >
          {profile.name}
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
          {t("hero.tagline")}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 sm:justify-start">
          <a
            href={`/${lang}/projects`}
            class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
          >
            {t("hero.cta.projects")}
          </a>
          <a
            href={cvHref}
            class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            {t("hero.cta.cv")}
          </a>
          <a
            href="#contact"
            class="rounded-lg px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            {t("hero.cta.contact")}
          </a>
        </div>
      </div>

      <Image
        src={profilePhoto}
        alt={profile.name}
        width={208}
        height={208}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="reveal h-32 w-32 shrink-0 rounded-full object-cover shadow-lg ring-4 ring-white sm:h-44 sm:w-44 lg:h-52 lg:w-52 dark:ring-slate-800"
      />
    </div>
  </section>

  <!-- About / CV -->
  <section
    id="about"
    class="scroll-mt-24 border-t border-slate-200/70 bg-slate-50/50 dark:border-slate-800/70 dark:bg-slate-900/30"
  >
    <div class="reveal mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white">
        {t("about.title")}
      </h2>
      <p class="mt-4 max-w-3xl text-slate-600 dark:text-slate-300">
        {bio[lang]}
      </p>

      <div class="mt-10 grid gap-10 md:grid-cols-2">
        <!-- Experience -->
        <div>
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">
            {t("about.experience")}
          </h3>
          <ul class="mt-4 space-y-5">
            {
              experience.map((item) => (
                <li class="border-l-2 border-brand-500 pl-4">
                  <p class="font-medium text-slate-900 dark:text-white">
                    {item.role[lang]}
                  </p>
                  <p class="text-sm text-slate-500 dark:text-slate-400">
                    {item.company} · {item.period[lang]}
                  </p>
                  <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                    {item.description[lang]}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Education -->
        <div>
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">
            {t("about.education")}
          </h3>
          <ul class="mt-4 space-y-5">
            {
              education.map((item) => (
                <li class="border-l-2 border-slate-300 pl-4 dark:border-slate-600">
                  <p class="font-medium text-slate-900 dark:text-white">
                    {item.title[lang]}
                  </p>
                  <p class="text-sm text-slate-500 dark:text-slate-400">
                    {item.institution} · {item.period[lang]}
                    {item.note && (
                      <span class="font-medium text-slate-700 dark:text-slate-300">
                        {" · "}
                        {item.note[lang]}
                      </span>
                    )}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Skills -->
      <div class="mt-10">
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white">
          {t("about.skills")}
        </h3>
        {/*
          Two-column grid rather than a fixed label width: the first column sizes
          itself to the longest label, so no label wraps and the width adapts to
          each language on its own. `items-start` keeps the chips at their natural
          height — flex children stretch by default, which made them grow taller
          than their text whenever a row did.
        */}
        <dl class="mt-4 sm:grid sm:grid-cols-[auto_1fr] sm:gap-x-6 sm:gap-y-4">
          {
            skills.map((group) => (
              <Fragment>
                <dt class="pt-1 text-sm font-medium text-slate-500 dark:text-slate-400">
                  {group.label[lang]}
                </dt>
                <dd class="mt-2 mb-5 flex flex-wrap items-start gap-2 sm:my-0">
                  {group.items.map((skill) => (
                    <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-sm text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                      {skill}
                    </span>
                  ))}
                </dd>
              </Fragment>
            ))
          }
        </dl>
      </div>

      <a
        href={cvHref}
        class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400"
      >
        {t("about.downloadCv")} &rarr;
      </a>
    </div>
  </section>

  <!-- Featured projects -->
  {
    featured.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
        <div class="reveal flex items-end justify-between">
          <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white">
            {t("projects.featured")}
          </h2>
          <a
            href={`/${lang}/projects`}
            class="text-sm font-semibold text-brand-600 hover:text-brand-700 dark:text-brand-400"
          >
            {t("projects.all")} &rarr;
          </a>
        </div>
        <div class="reveal-stagger mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((project) => (
            <ProjectCard
              href={projectUrl(lang, project)}
              title={project.data.title}
              description={project.data.description}
              stack={project.data.stack}
              cover={project.data.cover}
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- Contact -->
  <section
    id="contact"
    class="scroll-mt-24 border-t border-slate-200/70 dark:border-slate-800/70"
  >
    <div class="reveal mx-auto max-w-5xl px-4 py-16 text-center sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white">
        {t("contact.title")}
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-300">
        {t("contact.subtitle")}
      </p>

      <ContactForm />

      <p class="mt-8 text-sm text-slate-500 dark:text-slate-400">
        {t("contact.form.or")}:
      </p>
      <ul
        class="mt-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm"
      >
        <li>
          <a
            href={`mailto:${profile.email}`}
            class="font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400"
          >
            Email
          </a>
        </li>
        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</li>
        <li>
          <a
            href={profile.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400"
          >
            WhatsApp
          </a>
        </li>
        <li aria-hidden="true" class="text-slate-300 dark:text-slate-600">·</li>
        <li>
          <a
            href={profile.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-brand-600 hover:text-brand-700 dark:text-brand-400"
          >
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
